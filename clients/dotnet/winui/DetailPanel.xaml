<UserControl
    x:Class="FleetWinUI.DetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Fleet.Client.Core"
    Width="360">

    <!--
        The same detail panel as the WPF client, bound to the same shared ViewModel.

        Differences from the WPF version are dialect, not design: x:Bind instead of Binding,
        theme resources instead of hand-declared brushes, and Visibility driven by a bound
        boolean rather than a DataTrigger, which WinUI does not have. The data, the loading
        and the sparkline arithmetic are all shared.
    -->

    <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto"
                  BorderThickness="1" CornerRadius="6"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="2">

            <Grid>
                <TextBlock Text="{x:Bind ViewModel.Detail.Device.DeviceId, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" />
                <Button Content="X" HorizontalAlignment="Right" Padding="8,2"
                        Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.CloseDetailCommand}" />
            </Grid>

            <!-- Live fields, from the DeviceViewModel the grid already holds. These keep
                 updating from the socket while the panel is open. -->
            <Grid Margin="0,12,0,0" ColumnSpacing="8" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Site" FontSize="11" Opacity="0.6" />
                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12"
                           Text="{x:Bind ViewModel.Detail.Device.Site, Mode=OneWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" FontSize="11" Opacity="0.6" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12"
                           Text="{x:Bind ViewModel.Detail.Device.OfflineReason, Mode=OneWay, FallbackValue=online}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" FontSize="11" Opacity="0.6" />
                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12"
                           Text="{x:Bind ViewModel.Detail.Device.Model, Mode=OneWay}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Firmware" FontSize="11" Opacity="0.6" />
                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12"
                           Text="{x:Bind ViewModel.Detail.Device.Firmware, Mode=OneWay}" />

                <!-- The ordering key. A change means the device rebooted and its sequence
                     restarted, which is otherwise invisible. -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Boot" FontSize="11" Opacity="0.6" />
                <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Consolas" FontSize="11"
                           Text="{x:Bind ViewModel.Detail.Device.BootId, Mode=OneWay}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Sequence" FontSize="11" Opacity="0.6" />
                <TextBlock Grid.Row="5" Grid.Column="1" FontFamily="Consolas" FontSize="12"
                           Text="{x:Bind ViewModel.Detail.Device.Seq, Mode=OneWay}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Gaps" FontSize="11" Opacity="0.6" />
                <TextBlock Grid.Row="6" Grid.Column="1" FontFamily="Consolas" FontSize="12"
                           Text="{x:Bind ViewModel.Detail.Device.Gaps, Mode=OneWay}" />
            </Grid>

            <!-- readings -->
            <Grid Margin="0,14,0,0" ColumnSpacing="6" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Padding="8,5" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.Detail.Device.Temperature, Mode=OneWay}" />
                        <TextBlock Text="DEG C" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="8,5" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.Detail.Device.Humidity, Mode=OneWay}" />
                        <TextBlock Text="RH%" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="8,5" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.Detail.Device.Voltage, Mode=OneWay}" />
                        <TextBlock Text="VOLTS" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="8,5" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.Detail.Device.Signal, Mode=OneWay}" />
                        <TextBlock Text="dBm" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="TEMPERATURE, LAST HOUR" FontSize="10" Opacity="0.6" Margin="0,16,0,4" />

            <Border Height="70" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <!-- Filled from code-behind, for the same reason as the WPF host: the shared
                     ViewModel stops at normalised vertices because the two frameworks have
                     incompatible geometry types. -->
                <Canvas x:Name="SparkCanvas" Background="Transparent">
                    <Polyline x:Name="SparkLine" Stroke="#84ADFF" StrokeThickness="1.5" />
                </Canvas>
            </Border>
            <TextBlock FontSize="10" Opacity="0.6"
                       Text="{x:Bind ViewModel.Detail.TemperatureRange, Mode=OneWay}" />

            <TextBlock Text="RECENT EVENTS" FontSize="10" Opacity="0.6" Margin="0,16,0,4" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Events, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:DeviceEvent">
                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Kind}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Severity}" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Detail}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
